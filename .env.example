# ==============================================================================
# Environment Configuration Template (.env.example)
# Platform: Professor Mohammad Mahdi AI
# Note: Copy this file to .env and provide your actual values.
# NEVER commit your real .env file or credentials to version control!
# ==============================================================================

# Gemini AI API Key (Server-Side Only - used for AI chat and account analysis)
GEMINI_API_KEY=

# Application Hosted URL (Optional, defaults to runtime host)
APP_URL=

# PostgreSQL Database Connection String (Optional, for persistent multi-instance storage)
# Example format: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Database SSL Enforcement (Set to 'true' if required by PostgreSQL provider)
DATABASE_SSL=

# Redis Connection String (Optional, for distributed locking and caching across multi-instance clusters)
# Example format: redis://:password@host:6379/0
REDIS_URL=

# Optional: Meta Graph API Token for Instagram Business Discovery verification
INSTAGRAM_GRAPH_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Optional: TikTok Open API Bearer Token
TIKTOK_ACCESS_TOKEN=
