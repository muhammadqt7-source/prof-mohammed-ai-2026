# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string for production database (multi-instance shared storage)
# e.g., postgresql://postgres:password@postgres-host:5432/mahdidb?sslmode=require
DATABASE_URL=

# DATABASE_SSL: Set to 'true' if PostgreSQL server requires SSL certificate encryption
DATABASE_SSL=false

# REDIS_URL: Redis connection URL for distributed locking, caching, and rate limiting
# e.g., redis://:password@redis-host:6379/0
REDIS_URL=

# Official Social Account Verification Tokens (Optional for live Meta/TikTok Graph API discovery)
# Meta Graph API Token for Instagram Business Discovery
INSTAGRAM_GRAPH_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# TikTok Open API Bearer Token
TIKTOK_ACCESS_TOKEN=
